# Reddit API Credentials (Optional - only needed if collecting Reddit data)
# To get these values:
# 1. Go to https://www.reddit.com/prefs/apps
# 2. Click "Create app" and select "script"
# 3. Copy your client_id and client_secret below
# 4. Set a user agent (e.g., "IPL_Sentiment_Analyzer/1.0")

REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=IPL_Sentiment_Analyzer/1.0
